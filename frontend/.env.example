# ── Stellar / Soroban ─────────────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=testnet           # "testnet" or "mainnet" (defaults to testnet)
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=       # Custom Stellar network passphrase; defaults to public or testnet passphrase
NEXT_PUBLIC_SOROBAN_RPC_URL=                  # Soroban RPC endpoint URL
NEXT_PUBLIC_HORIZON_URL=                      # Horizon API endpoint URL
NEXT_PUBLIC_FACTORY_CONTRACT_ID=              # Stellar contract ID for Arena Factory contract
NEXT_PUBLIC_USDC_CONTRACT_ID=                 # Soroban token contract ID for USDC
NEXT_PUBLIC_XLM_CONTRACT_ID=                  # Soroban contract ID for native XLM token wrapper (optional)
NEXT_PUBLIC_STAKING_CONTRACT_ID=              # Stellar contract ID for Staking contract (optional)
NEXT_PUBLIC_RWA_VAULT_CONTRACT_ID=            # Stellar contract ID for RWA Vault contract (optional)
NEXT_PUBLIC_ORACLE_CONTRACT_ID=               # Stellar contract ID for Oracle contract (optional)
NEXT_PUBLIC_APP_ORIGIN=                       # Canonical frontend application origin URL
NEXT_PUBLIC_CONTRACT_MANIFEST_PATH=contract/deployment-manifest.json # Optional path to local contract deployment manifest (#1462)

# ── Classic asset issuers (#1487) ─────────────────────────────────────────
# A `changeTrust` is keyed by the exact (code, issuer) pair, so a stake or
# payout in a credit asset cannot be settled without its issuer. These are the
# issuers for the *classic* path; they are separate from the Soroban token
# contract ids above, and the same asset has two distinct identifiers on
# Stellar. The app never guesses an issuer: an unset value blocks every
# action denominated in that asset with a message naming the variable to set,
# rather than defaulting to something that would create a trustline the user
# does not hold.
#
# XLM needs none of this — it is the native asset and has no trustline.
NEXT_PUBLIC_USDC_ISSUER=                      # Classic credit-asset issuer public key (G...) for USDC
NEXT_PUBLIC_EURC_ISSUER=                      # Classic credit-asset issuer public key (G...) for EURC

# ── Arena ─────────────────────────────────────────────────────────────────
# Stellar contract address of the arena to display on /arena (C + 55 base-32 chars).
# When unset the arena page falls back to static demo data instead of live on-chain state.
NEXT_PUBLIC_DEMO_ARENA_ID=                    # Stellar contract address of the demo arena to display on /arena

# ── Backend API & Dev Toggles ─────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=                     # Base URL for backend API calls (defaults to http://localhost:4000)
NEXT_PUBLIC_USE_MOCK_PROFILE=                 # Toggle mock profile data in development ('true' or 'false')
NEXT_PUBLIC_PASSKEY_DEMO_MODE=                # Toggle passkey demo mode in development ('true' or 'false')
NEXT_PUBLIC_TELEMETRY_POLL_INTERVAL_MS=       # Telemetry polling interval in milliseconds

# ── Web Push (#1571) ─────────────────────────────────────────────────────────
# Base64url VAPID public key from the backend VAPID keypair. Required for the
# push opt-in on the profile page; when unset the button reports "not configured".
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────

ALLOWED_ORIGINS=                              # Comma-separated list of allowed CORS origins for API routes

# ── Redis (rate limiting) ─────────────────────────────────────────────────
# Required for a shared global rate limit across instances. When unset, the
# limiter falls back to per-process in-memory counting (effective limit becomes
# points × instance_count) and logs a startup warning.
REDIS_URL=                                    # Redis connection URL for distributed rate limiting
TRUSTED_PROXY_COUNT=0                         # Number of trusted reverse proxies (CDN / load balancer) in front of the app

# ── Sentry (error reporting) ──────────────────────────────────────────────
# Obtain your DSN from https://sentry.io → Settings → Projects → Client Keys.
# Leave blank to disable error reporting (safe for local development).
NEXT_PUBLIC_SENTRY_DSN=                       # Sentry DSN for client and server error reporting
NEXT_PUBLIC_SENTRY_ENVIRONMENT=               # Optional: label events by environment (defaults to NODE_ENV)
NEXT_PUBLIC_SENTRY_RELEASE=                   # Optional: set by CI to git SHA or semver tag for release tracking
SENTRY_AUTH_TOKEN=                            # Server-only: Sentry auth token for uploading source maps during build
