# ── Stellar / Soroban ────────────────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=testnet          # "testnet" or "mainnet" (defaults to testnet)
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=
NEXT_PUBLIC_SOROBAN_RPC_URL=
NEXT_PUBLIC_HORIZON_URL=
NEXT_PUBLIC_FACTORY_CONTRACT_ID=
NEXT_PUBLIC_USDC_CONTRACT_ID=
NEXT_PUBLIC_RWA_VAULT_CONTRACT_ID=
NEXT_PUBLIC_ORACLE_CONTRACT_ID=
NEXT_PUBLIC_APP_ORIGIN=

# ── Arena ─────────────────────────────────────────────────────────────────────
# Stellar contract address of the arena to display on /arena (C + 55 base-32 chars).
# When unset the arena page falls back to static demo data instead of live on-chain state.
NEXT_PUBLIC_DEMO_ARENA_ID=

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=

# ── Redis (rate limiting) ─────────────────────────────────────────────────────
REDIS_URL=

# ── Sentry (error reporting) ─────────────────────────────────────────────────
# Obtain your DSN from https://sentry.io → Settings → Projects → Client Keys.
# Leave blank to disable error reporting (safe for local development).
NEXT_PUBLIC_SENTRY_DSN=

# Optional: label events by environment in the Sentry dashboard.
# Defaults to NODE_ENV ("development", "production", etc.) when not set.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Optional: set by CI to the git SHA or semver tag for release tracking.
NEXT_PUBLIC_SENTRY_RELEASE=
