# Generated from frontend/src/shared/config/env/spec.ts by scripts/env-example.ts. Do not edit:
# change the schema and run `npx tsx scripts/env-example.ts`.
#
# Required variables are uncommented. Optional ones are commented out and
# fall back to the default noted above them.

# ── Stellar / Soroban ─────────────────────────────────────────────────────────

# Network the app targets.
# Default: testnet.
# NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Overrides the passphrase implied by NEXT_PUBLIC_STELLAR_NETWORK.
# NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=

# Soroban RPC endpoint.
# Required.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Horizon endpoint.
# Required.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Arena factory contract.
# Required.
NEXT_PUBLIC_FACTORY_CONTRACT_ID=C...

# USDC token contract.
# Required.
NEXT_PUBLIC_USDC_CONTRACT_ID=C...

# Native XLM Stellar Asset Contract. Defaults to the testnet SAC.
# NEXT_PUBLIC_XLM_CONTRACT_ID=

# Staking contract.
# NEXT_PUBLIC_STAKING_CONTRACT_ID=

# RWA yield vault adapter.
# NEXT_PUBLIC_RWA_VAULT_CONTRACT_ID=

# Yield oracle contract.
# NEXT_PUBLIC_ORACLE_CONTRACT_ID=

# ── Classic asset issuers ─────────────────────────────────────────────────────

# Issuer of classic USDC. A changeTrust is keyed by the exact (code, issuer)
# pair, so the app never guesses one: when unset, every USDC action is blocked
# with a message naming this variable. Must match the backend's ASSET_ISSUERS.
# NEXT_PUBLIC_USDC_ISSUER=

# Issuer of classic EURC. Same rules as NEXT_PUBLIC_USDC_ISSUER.
# NEXT_PUBLIC_EURC_ISSUER=

# ── App ───────────────────────────────────────────────────────────────────────

# Backend API origin.
# Default: http://localhost:4000.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# This app's public origin, added to the CORS allowlist by the proxy.
# NEXT_PUBLIC_APP_ORIGIN=

# Public site origin used in the sitemap.
# Default: https://app.inversearena.io.
# NEXT_PUBLIC_SITE_URL=https://app.inversearena.io

# Arena contract shown on /arena. When unset the page shows static demo data.
# NEXT_PUBLIC_DEMO_ARENA_ID=

# Dashboard telemetry refresh interval.
# Default: 60000.
# NEXT_PUBLIC_TELEMETRY_POLL_INTERVAL_MS=60000

# Price endpoint for the telemetry bar. Defaults to CoinGecko's public
# simple-price API.
# NEXT_PUBLIC_COINGECKO_SIMPLE_PRICE_URL=

# Base64url VAPID public key from the backend's keypair (#1571). The push opt-in
# reports not-configured when unset.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Enable the passkey demo wallet. Always off in production builds.
# Default: false.
# NEXT_PUBLIC_PASSKEY_DEMO_MODE=false

# Serve profile data from fixtures instead of the API.
# Default: false.
# NEXT_PUBLIC_USE_MOCK_PROFILE=false

# ── Sentry ────────────────────────────────────────────────────────────────────

# Sentry DSN (public by design). Leave unset to disable error reporting.
# NEXT_PUBLIC_SENTRY_DSN=

# Environment label in Sentry. Defaults to NODE_ENV.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Release identifier, set by CI to the git SHA or tag.
# NEXT_PUBLIC_SENTRY_RELEASE=

# ── Server (never exposed to the browser) ─────────────────────────────────────

# Comma-separated extra origins allowed by the proxy's CORS policy.
# ALLOWED_ORIGINS=

# Redis for a shared rate limit across instances. Unset falls back to
# per-process counting (effective limit = points × instances).
# Secret: never commit a real value.
# REDIS_URL=

# Reverse proxies in front of the app. Controls how X-Forwarded-For is read for
# rate-limit buckets; 0 ignores the header so callers cannot spoof it.
# Default: 0.
# TRUSTED_PROXY_COUNT=0

# Uploads source maps to Sentry during `next build`. Build-time only.
# Secret: never commit a real value.
# SENTRY_AUTH_TOKEN=

# Set to 1 to skip schema validation in `next build`, e.g. for an image built
# before its environment exists. The NEXT_PUBLIC_ secret check still runs.
# SKIP_ENV_VALIDATION=
