{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "src/features/asset-readiness/model/__tests__/asset-readiness.test.ts",
    "src/features/asset-readiness/model/__tests__/stake-asset.test.ts",
    "src/features/pools/model/__tests__/pool-draft.test.ts",
    "src/features/pools/model/__tests__/pool-schema.test.ts",
    "src/shared/lib/__tests__/form-validation.test.ts",
    "src/shared/lib/__tests__/identity-value-objects.test.ts",
    "src/shared/lib/__tests__/mutation-coordinator.test.ts",
    "src/shared/lib/stellar/__tests__/change-trust-transaction.test.ts",
    "src/shared/lib/stellar/__tests__/commit-reveal.test.ts",
    "src/shared/lib/stellar/__tests__/compatibility.test.tsx",
    "src/shared/lib/stellar/__tests__/contract-client-factory.test.ts",
    "src/shared/lib/stellar/__tests__/contract-error-registry.test.ts",
    "src/shared/lib/stellar/__tests__/contract-error.attribution.test.ts",
    "src/shared/lib/stellar/__tests__/contract-error.test.ts",
    "src/shared/lib/stellar/__tests__/contract-state-parsers.player-status.test.ts",
    "src/shared/lib/stellar/__tests__/contract-state-parsers.proof-bundle.test.ts",
    "src/shared/lib/stellar/__tests__/contract-state-parsers.test.ts",
    "src/shared/lib/stellar/__tests__/fetchArenaState.single-rpc.test.ts",
    "src/shared/lib/stellar/__tests__/fetchArenaState.test.ts",
    "src/shared/lib/stellar/__tests__/horizon-account-loader.test.ts",
    "src/shared/lib/stellar/__tests__/metadata-hash.test.ts",
    "src/shared/lib/stellar/__tests__/parseStellarError.test.ts",
    "src/shared/lib/stellar/__tests__/scval-helpers.test.ts",
    "src/shared/lib/stellar/__tests__/soroban-transaction-composer.test.ts",
    "src/shared/lib/stellar/__tests__/stellar-balance.test.ts",
    "src/shared/lib/stellar/__tests__/stellar-fee-estimator.test.ts",
    "src/shared/lib/stellar/__tests__/stellar-scval-extract.test.ts",
    "src/shared/lib/stellar/__tests__/stellar-transactions.commit-reveal.test.ts",
    "src/shared/lib/stellar/__tests__/stellar-transactions.reconciliation.test.ts",
    "src/shared/lib/stellar/__tests__/submitSignedTransaction.test.ts",
    "src/server/rate-limit/limiter.test.ts",
    "src/app/pools/validation.test.ts",
    "src/app/pools/validation.ts"
  ]
}
