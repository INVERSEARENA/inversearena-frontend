# ── Server ────────────────────────────────────────────────────────────────
PORT=3001                                     # HTTP server port
NODE_ENV=development                          # 'development', 'production', or 'test'
LOG_LEVEL=info                                # Pino log level ('info', 'debug', 'warn', etc.)

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inversearena?schema=public # PostgreSQL connection string (Prisma)

# ── MongoDB ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/inversearena # MongoDB connection string for off-chain transactional records

# ── Admin auth ────────────────────────────────────────────────────────────
# Must be ≥32 characters (enforced at startup) to resist timing attacks
# ⚠️ Change this from the default value before deploying
ADMIN_API_KEY=change-me-in-production         # Admin API key for privileged operations (minimum 32 characters)
ADMIN_TOKEN_TTL_SECONDS=900                   # Admin confirmation token TTL in seconds. Minimum 300 (or 0 for API key auth only)
ADMIN_WALLET_ADDRESSES=                       # Comma-separated Stellar public keys authorized to manage arenas

# ── Wallet auth (JWT) ─────────────────────────────────────────────────────
# Rotation (#1456, docs/design/secret-rotation.md): during an overlap window the
# previous secret is verify-only until the expiry (ISO-8601, at most 30 days).
# JWT_SECRET_KID=
# JWT_SECRET_PREVIOUS=
# JWT_SECRET_PREVIOUS_KID=
# JWT_SECRET_PREVIOUS_EXPIRES_AT=2026-01-08T00:00:00Z
JWT_SECRET=change-me-minimum-32-characters-long # JWT signing secret (minimum 32 characters)
JWT_EXPIRES_IN=15m                            # Access token lifetime
JWT_REFRESH_EXPIRES_IN=7d                     # Refresh token lifetime
NONCE_TTL_SECONDS=300                         # Wallet auth challenge nonce TTL

# ── Soroban / Stellar ─────────────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org # Soroban RPC endpoint
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015 # Stellar network passphrase
PAYOUT_CONTRACT_ID=C...                       # Contract ID for payout distribution
PAYOUT_SOURCE_ACCOUNT=G...                    # Stellar account ID for payout transaction source account
ARENA_FACTORY_CONTRACT_ID=C...                # Contract ID for Arena Factory contract
PAYOUT_METHOD_NAME=distribute_winnings        # Contract method name invoked for payouts
CONTRACT_MANIFEST_PATH=../contract/deployment-manifest.json # Optional: path to local contract deployment manifest (#1462)

# ── Oracle webhook ────────────────────────────────────────────────────────
# Same rotation contract as JWT. Senders may name the key via `x-oracle-key-id`.
# ORACLE_WEBHOOK_SECRET_KID=
# ORACLE_WEBHOOK_SECRET_PREVIOUS=
# ORACLE_WEBHOOK_SECRET_PREVIOUS_KID=
# ORACLE_WEBHOOK_SECRET_PREVIOUS_EXPIRES_AT=
ORACLE_WEBHOOK_SECRET=change-me-in-production # Shared secret for Oracle webhook verification

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379              # Redis connection URL

# ── Rate limiting (defaults shown) ────────────────────────────────────────
# RATE_LIMIT_NONCE_PREFIX=rl:auth:nonce
# RATE_LIMIT_NONCE_POINTS=5
# RATE_LIMIT_NONCE_WINDOW_SECONDS=60
# RATE_LIMIT_VERIFY_PREFIX=rl:auth:verify
# RATE_LIMIT_VERIFY_POINTS=10
# RATE_LIMIT_VERIFY_WINDOW_SECONDS=60
# RATE_LIMIT_REFRESH_PREFIX=rl:auth:refresh
# RATE_LIMIT_REFRESH_POINTS=20
# RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
# RATE_LIMIT_POOLS_PREFIX=rl:pools:create
# RATE_LIMIT_POOLS_POINTS=3
# RATE_LIMIT_POOLS_WINDOW_SECONDS=60
# SSE_MAX_CONNECTIONS_PER_IP=5
# SSE_MAX_CONNECTIONS_PER_ARENA=100

# ── Payout execution flags ────────────────────────────────────────────────
PAYOUTS_LIVE_EXECUTION=false                  # Enable live on-chain payouts
PAYOUTS_SIGN_WITH_HOT_KEY=false               # Sign with hot key

# ── Payout worker tuning ──────────────────────────────────────────────────
# Optional: only set in controlled environments
# PAYOUT_HOT_SIGNER_SECRET=S...
PAYOUTS_MAX_GAS_STROOPS=2000000               # Max gas stroops
PAYOUTS_MAX_ATTEMPTS=5                        # Max transaction attempts
PAYOUTS_CONFIRM_POLL_MS=2500                  # Confirmation poll interval
PAYOUTS_CONFIRM_MAX_POLLS=20                  # Max confirmation polls
PAYOUTS_FAILED_RETRY_MAX=3                    # Retry count for failed payouts
PAYOUTS_FAILED_RETRY_BASE_MS=5000             # Base retry backoff in ms
TX_WORKER_CONCURRENCY=1                       # Worker concurrency

# ── resolveRound on-chain confirmation polling (#1193) ────────────────────
ROUND_CONFIRM_POLL_MS=2500                    # Base delay between polls in ms
ROUND_CONFIRM_MAX_POLLS=20                    # Maximum number of polls before giving up

# ── Settlement receipts (#1407) ───────────────────────────────────────────
# Basis points (0-10000) of a round's yield portion withheld as a platform
# fee when computing the settlement breakdown (principal/yield/fee/dust).
# Defaults to 0 — no fee is withheld and payout amounts are unchanged from
# before this feature existed — unless explicitly set.
PLATFORM_FEE_BPS=0                            # Platform fee in basis points (0-10000)

# Web Push delivery for time-critical round alerts (#1571)
# Generate with: openssl ecparam -genkey -name prime256v1 -noout -out vapid_private.pem
# and derive the public key (base64url, 65-byte uncompressed) for VAPID_PUBLIC_KEY.
# VAPID_PRIVATE_KEY is the PEM-encoded EC private key (single line ok).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact for push operators (mailto: or https: URL, sent as the VAPID `sub` claim).
# VAPID_SUBJECT=mailto:ops@example.com
# 32 random bytes as 64 hex chars for AES-256-GCM encryption of stored push
# keys at rest. Generate with: openssl rand -hex 32
# PUSH_ENCRYPTION_KEY=
# Treasury fee reconciliation (#1511)
# Expected fee-collection destination address. There is no on-chain
# treasury/fee-destination concept today (see
# backend/docs/TREASURY_RECONCILIATION_DESIGN.md §1) — this is what
# reconciliation reports a nonzero fee against; leave unset until real fee
# collection is wired up on-chain.
# TREASURY_DESTINATION=
# Seconds after a ledger closes before an unmatched fee record is reported
# as a real discrepancy rather than "pending"/unfinalized (late events / reorgs).
TREASURY_FINALITY_GRACE_SECONDS=120

# Classic credit-asset issuers (#1489 — claim inbox asset metadata)
# Comma-separated CODE:ISSUER pairs, e.g.
#   ASSET_ISSUERS=USDC:GABC...,EURC:GDEF...
# A credit asset is identified by the pair (code, issuer), so a code with no
# entry here cannot be described to clients and is reported with a null issuer
# and counted in claim_inbox_unconfigured_asset_total. Issuers are never
# inferred. Must match the frontend's NEXT_PUBLIC_USDC_ISSUER /
# NEXT_PUBLIC_EURC_ISSUER. XLM is native and must not be listed. A malformed
# entry fails at boot rather than being ignored.
ASSET_ISSUERS=

