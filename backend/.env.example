# Server
PORT=3001

# Database
# Point to PgBouncer for connection pooling (default: localhost:5432)
# Direct connection for migrations: postgresql://postgres:postgres@localhost:5433/inversearena
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inversearena?schema=public

# Database Connection Pooling
# Process role determines default pool size:
# - API: 10 connections (short-lived requests)
# - WORKER: 5 connections (payment worker, outbox dispatcher)
# - RECONCILER: 3 connections (transaction reconciler)
# - BACKFILL: 2 connections (data backfill jobs)
# - MIGRATION: 1 connection (schema migrations)
PROCESS_ROLE=API

# Override default pool size for this role (optional)
# DB_POOL_SIZE=10

# Pool timeout in seconds (time to wait for available connection)
# DB_POOL_TIMEOUT=20

# Connection timeout in seconds (time to establish TCP connection)
# DB_CONNECTION_TIMEOUT=10

# MongoDB
MONGODB_URI=mongodb://localhost:27017/inversearena

# Admin auth
ADMIN_API_KEY=change-me-in-production
ADMIN_TOKEN_TTL_SECONDS=900

# Wallet auth (JWT)
JWT_SECRET=change-me-minimum-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NONCE_TTL_SECONDS=300

# Soroban / Stellar
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
PAYOUT_CONTRACT_ID=C...
PAYOUT_SOURCE_ACCOUNT=G...
PAYOUT_METHOD_NAME=distribute_winnings

# Redis
REDIS_URL=redis://localhost:6379

# Payout execution flags
PAYOUTS_LIVE_EXECUTION=false
PAYOUTS_SIGN_WITH_HOT_KEY=false

# Optional: only set in controlled environments
# PAYOUT_HOT_SIGNER_SECRET=S...

# Payout worker tuning
PAYOUTS_MAX_GAS_STROOPS=2000000
PAYOUTS_MAX_ATTEMPTS=5
PAYOUTS_CONFIRM_POLL_MS=2500
PAYOUTS_CONFIRM_MAX_POLLS=20
