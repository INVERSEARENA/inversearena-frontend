# Generated from backend/src/config/env.ts by scripts/env-example.ts. Do not edit:
# change the schema and run `npx tsx scripts/env-example.ts`.
#
# Required variables are uncommented. Optional ones are commented out and
# fall back to the default noted above them.

# ── Server ────────────────────────────────────────────────────────────────────

# Runtime mode. `test` relaxes the Stellar RPC defaults used by unit tests.
# NODE_ENV=development

# HTTP port.
# Default: 3001.
# PORT=3001

# pino log level.
# Default: info.
# LOG_LEVEL=info

# Comma-separated origins allowed by CORS. Empty allows none.
# ALLOWED_ORIGINS=http://localhost:3000

# Public origin of the web app, used in sign-in messages.
# Default: https://app.inversearena.com.
# PUBLIC_WEB_ORIGIN=https://app.inversearena.com

# Sentry DSN for error reporting. Leave unset to disable.
# SENTRY_DSN=

# ── Data stores ───────────────────────────────────────────────────────────────

# PostgreSQL connection string (Prisma).
# Required. Secret: never commit a real value.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inversearena?schema=public

# MongoDB connection string for transactions and intents.
# Required. Secret: never commit a real value.
MONGODB_URI=mongodb://localhost:27017/inversearena

# Redis for caching, queues and the shared rate limit.
# Default: redis://localhost:6379. Secret: never commit a real value.
# REDIS_URL=redis://localhost:6379

# ── Admin auth ────────────────────────────────────────────────────────────────

# Admin API key. At least 32 characters to resist brute-force and timing
# attacks. Generate with `openssl rand -hex 32`.
# Required. Secret: never commit a real value.
ADMIN_API_KEY=

# Admin confirmation token TTL in seconds: at least 300, or 0 for API-key auth
# only.
# Default: 900.
# ADMIN_TOKEN_TTL_SECONDS=900

# Comma-separated Stellar public keys allowed to manage arenas from
# /dashboard/admin. Being connected is not enough: only these addresses get
# isAdmin.
# ADMIN_WALLET_ADDRESSES=

# ── Wallet auth (JWT) ─────────────────────────────────────────────────────────

# JWT signing secret, at least 32 characters. Generate with `openssl rand -hex
# 32`.
# Required. Secret: never commit a real value.
JWT_SECRET=

# Optional explicit key id for JWT_SECRET. Derived from a fingerprint when
# unset.
# JWT_SECRET_KID=

# Previous JWT_SECRET, accepted for verification only during a rotation overlap
# (#1456, docs/design/secret-rotation.md).
# Secret: never commit a real value.
# JWT_SECRET_PREVIOUS=

# Optional explicit key id for the previous JWT_SECRET.
# JWT_SECRET_PREVIOUS_KID=

# End of the overlap window (ISO-8601, at most 30 days away). Required while
# JWT_SECRET_PREVIOUS is set.
# JWT_SECRET_PREVIOUS_EXPIRES_AT=2026-01-08T00:00:00Z

# Access token lifetime in seconds.
# Default: 900.
# JWT_ACCESS_EXPIRES_IN=900

# Refresh token lifetime in seconds.
# Default: 604800.
# JWT_REFRESH_EXPIRES_IN=604800

# Sign-in nonce lifetime in seconds.
# Default: 300.
# NONCE_TTL_SECONDS=300

# ── Soroban / Stellar ─────────────────────────────────────────────────────────

# Soroban RPC endpoint.
# Required.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase.
# Required.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Comma-separated hostnames outbound RPC may reach (#1447). Empty allows all.
# RPC_URL_ALLOWLIST=

# Largest RPC response accepted, in bytes (#1447).
# Default: 1048576.
# RPC_MAX_RESPONSE_BYTES=1048576

# Factory contract. POST /api/arenas checks the submitted txHash invoked
# create_pool on it.
# Required.
ARENA_FACTORY_CONTRACT_ID=

# Payout contract.
# Required.
PAYOUT_CONTRACT_ID=

# Account that submits payout transactions.
# Required.
PAYOUT_SOURCE_ACCOUNT=

# Payout contract method to invoke.
# PAYOUT_METHOD_NAME=distribute_winnings

# Staking contract. Staking endpoints report not-configured when unset.
# STAKING_CONTRACT_ID=

# Decimals of the staked asset.
# Default: 7.
# STAKING_ASSET_DECIMALS=7

# Classic credit-asset issuers as comma-separated CODE:ISSUER pairs (#1489).
# Must match the frontend's NEXT_PUBLIC_*_ISSUER. XLM is native and must not be
# listed.
# ASSET_ISSUERS=

# Secret seed that signs arena admin transactions (resolve_round). Server-side
# only.
# Secret: never commit a real value.
# ARENA_ADMIN_SECRET=

# Secret seed of the source account used to simulate read-only contract calls.
# Secret: never commit a real value.
# ARENA_SIM_SOURCE_SECRET=

# Base delay between resolve_round confirmation polls, with exponential backoff
# (#1193).
# Default: 2500.
# ROUND_CONFIRM_POLL_MS=2500

# Confirmation polls before giving up.
# Default: 20.
# ROUND_CONFIRM_MAX_POLLS=20

# ── Arenas ────────────────────────────────────────────────────────────────────

# Cap on a wallet's total active stake, in USDC.
# Default: 10000.
# MAX_ACTIVE_STAKE_USDC=10000

# How long a lobby seat reservation is held.
# Default: 120.
# LOBBY_RESERVATION_TTL_SECONDS=120

# Extra comma-separated words rejected in player aliases.
# ALIAS_BLOCK_LIST=

# Basis points of a round's yield withheld as platform fee in settlement
# receipts (#1407).
# Default: 0.
# PLATFORM_FEE_BPS=0

# ── Oracle ────────────────────────────────────────────────────────────────────

# Shared secret for the oracle webhook, at least 16 characters. Senders may name
# the key via `x-oracle-key-id`.
# Secret: never commit a real value.
# ORACLE_WEBHOOK_SECRET=

# Optional explicit key id for ORACLE_WEBHOOK_SECRET. Derived from a fingerprint
# when unset.
# ORACLE_WEBHOOK_SECRET_KID=

# Previous ORACLE_WEBHOOK_SECRET, accepted for verification only during a
# rotation overlap (#1456, docs/design/secret-rotation.md).
# Secret: never commit a real value.
# ORACLE_WEBHOOK_SECRET_PREVIOUS=

# Optional explicit key id for the previous ORACLE_WEBHOOK_SECRET.
# ORACLE_WEBHOOK_SECRET_PREVIOUS_KID=

# End of the overlap window (ISO-8601, at most 30 days away). Required while
# ORACLE_WEBHOOK_SECRET_PREVIOUS is set.
# ORACLE_WEBHOOK_SECRET_PREVIOUS_EXPIRES_AT=2026-01-08T00:00:00Z

# Oldest oracle observation accepted for yield-dependent actions (#1512). At
# most 86400.
# Default: 3600.
# ORACLE_MAX_AGE_SECONDS=3600

# Observation age that triggers a staleness warning. Must not exceed
# ORACLE_MAX_AGE_SECONDS.
# Default: 1800.
# ORACLE_WARN_AGE_SECONDS=1800

# ── Payouts ───────────────────────────────────────────────────────────────────

# Submit payouts on-chain. When false, payouts are prepared but not sent.
# Default: false.
# PAYOUTS_LIVE_EXECUTION=false

# Sign payouts with PAYOUT_HOT_SIGNER_SECRET instead of handing them to an
# external signer.
# Default: false.
# PAYOUTS_SIGN_WITH_HOT_KEY=false

# Hot signer secret seed. Only set in controlled environments.
# Secret: never commit a real value.
# PAYOUT_HOT_SIGNER_SECRET=

# Fee ceiling per payout transaction.
# Default: 2000000.
# PAYOUTS_MAX_GAS_STROOPS=2000000

# Submission attempts per payout.
# Default: 5.
# PAYOUTS_MAX_ATTEMPTS=5

# Delay between confirmation polls.
# Default: 2500.
# PAYOUTS_CONFIRM_POLL_MS=2500

# Confirmation polls before giving up.
# Default: 20.
# PAYOUTS_CONFIRM_MAX_POLLS=20

# Retries for payouts stuck in `failed` before dead-lettering (#1122).
# Default: 3.
# PAYOUTS_FAILED_RETRY_MAX=3

# Base backoff for those retries.
# Default: 5000.
# PAYOUTS_FAILED_RETRY_BASE_MS=5000

# Sponsor the network fee of payout claims.
# Default: false.
# PAYOUTS_FEE_SPONSORSHIP_ENABLED=false

# How long a fee sponsorship offer stays valid.
# Default: 72.
# PAYOUTS_FEE_SPONSORSHIP_TTL_HOURS=72

# ── Workers ───────────────────────────────────────────────────────────────────

# Concurrent jobs in the transaction reconciler.
# Default: 1.
# TX_WORKER_CONCURRENCY=1

# Legacy alias of TX_WORKER_CONCURRENCY, read only when that is unset.
# TX_RECONCILER_CONCURRENCY=

# Legacy alias of TX_WORKER_CONCURRENCY, read only when both others are unset.
# TX_WORKER_CAPACITY=

# Lifetime of a transaction intent before it expires (#1381).
# Default: 300000.
# INTENT_TTL_MS=300000

# Signing attempts per intent.
# Default: 5.
# INTENT_MAX_SIGN_ATTEMPTS=5

# Expected fee-collection address for treasury reconciliation (#1511). Leave
# unset until fee collection is wired up on-chain.
# TREASURY_DESTINATION=

# Seconds after a ledger closes before an unmatched fee is reported as a
# discrepancy.
# Default: 120.
# TREASURY_FINALITY_GRACE_SECONDS=120

# JSON array of deployment manifests for `npm run ttl:plan`.
# TTL_KEEPER_MANIFESTS=

# Renew entries whose TTL is below this many ledgers.
# TTL_KEEPER_RENEW_BELOW_LEDGERS=

# Renewal cap per `ttl:plan` run.
# TTL_KEEPER_MAX_RENEWALS_PER_RUN=

# Renewal cap per contract per run.
# TTL_KEEPER_MAX_RENEWALS_PER_CONTRACT=

# ── Rate limiting ─────────────────────────────────────────────────────────────

# Prefix that separates this app's rate-limit keys in a shared Redis.
# RATE_LIMIT_APP_NAMESPACE=

# Reverse proxies in front of the app. Controls how X-Forwarded-For is read for
# rate-limit buckets; 0 ignores the header.
# Default: 0.
# TRUSTED_PROXY_COUNT=0

# Requests allowed per window for auth nonce requests (packages/rate-limit).
# Default: 5.
# RATE_LIMIT_NONCE_POINTS=5

# Window length in seconds for auth nonce requests.
# Default: 60.
# RATE_LIMIT_NONCE_WINDOW_SECONDS=60

# Requests allowed per window for auth verify requests (packages/rate-limit).
# Default: 10.
# RATE_LIMIT_VERIFY_POINTS=10

# Window length in seconds for auth verify requests.
# Default: 60.
# RATE_LIMIT_VERIFY_WINDOW_SECONDS=60

# Requests allowed per window for token refreshes (packages/rate-limit).
# Default: 20.
# RATE_LIMIT_REFRESH_POINTS=20

# Window length in seconds for token refreshes.
# Default: 60.
# RATE_LIMIT_REFRESH_WINDOW_SECONDS=60

# Requests allowed per window for pool creation (packages/rate-limit).
# Default: 3.
# RATE_LIMIT_POOLS_POINTS=3

# Window length in seconds for pool creation.
# Default: 60.
# RATE_LIMIT_POOLS_WINDOW_SECONDS=60

# Requests allowed per window for arena player syncs (packages/rate-limit).
# Default: 3.
# RATE_LIMIT_SYNC_PLAYERS_POINTS=3

# Window length in seconds for arena player syncs.
# Default: 60.
# RATE_LIMIT_SYNC_PLAYERS_WINDOW_SECONDS=60

# Requests allowed per window for lobby reservations (packages/rate-limit).
# Default: 10.
# RATE_LIMIT_RESERVATION_POINTS=10

# Window length in seconds for lobby reservations.
# Default: 60.
# RATE_LIMIT_RESERVATION_WINDOW_SECONDS=60

# Requests allowed per window for admin wallet-role checks
# (packages/rate-limit).
# Default: 20.
# RATE_LIMIT_WALLET_ROLE_POINTS=20

# Window length in seconds for admin wallet-role checks.
# Default: 60.
# RATE_LIMIT_WALLET_ROLE_WINDOW_SECONDS=60

# Requests allowed per window for transaction simulations (packages/rate-limit).
# Default: 5.
# RATE_LIMIT_SIMULATION_POINTS=5

# Window length in seconds for transaction simulations.
# Default: 60.
# RATE_LIMIT_SIMULATION_WINDOW_SECONDS=60

# Active SSE streams accepted per client IP.
# Default: 5.
# SSE_MAX_CONNECTIONS_PER_IP=5

# Active SSE streams accepted per arena.
# Default: 100.
# SSE_MAX_CONNECTIONS_PER_ARENA=100

# ── Web Push ──────────────────────────────────────────────────────────────────

# Base64url VAPID public key (65-byte uncompressed point). Push is disabled when
# unset.
# VAPID_PUBLIC_KEY=

# PEM-encoded EC private key for VAPID. Generate with `openssl ecparam -genkey
# -name prime256v1 -noout`.
# Secret: never commit a real value.
# VAPID_PRIVATE_KEY=

# Contact sent as the VAPID `sub` claim (mailto: or https: URL).
# VAPID_SUBJECT=mailto:ops@example.com

# AES-256-GCM key for stored push keys: 64 hex chars. Generate with `openssl
# rand -hex 32`.
# Secret: never commit a real value.
# PUSH_ENCRYPTION_KEY=
