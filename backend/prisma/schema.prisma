// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TODO(#1444): Add production-plan-validated indexes for arena stats queries.
// TODO(#1444): Store the supporting EXPLAIN fixtures.

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique @map("wallet_address")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  transactions           Transaction[]
  eliminationLogs        EliminationLog[]
  notificationPreference NotificationPreference?
  notificationDeliveries NotificationDelivery[]
  pushSubscriptions      PushSubscription[]
  arenaMessages          ArenaMessage[]
  messageReports         MessageReport[]
  followers              Follow[]                @relation("FollowedBy")
  following              Follow[]                @relation("Following")
  clanMember             ClanMember?
  referralCodesIssued    ReferralCode[]          @relation("ReferralCodesIssued")
  referralRewards        ReferralReward[]        @relation("ReferralRewardsReceived")

  @@map("users")
}

model Arena {
  id        String   @id @default(uuid())
  metadata  Json? // Stores generic arena settings (e.g. entry fee, limits)
  // Arena id this arena is a rematch of (#1572). Null for original arenas.
  rematchOf String?  @map("rematch_of")
  status    String   @default("ACTIVE")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pools         Pool[]
  rounds        Round[]
  stats         ArenaStats?
  rematchSource Arena?      @relation("ArenaRematch", fields: [rematchOf], references: [id])
  rematches     Arena[]     @relation("ArenaRematch")

  @@index([createdAt(sort: Desc), id(sort: Desc)]) // Keyset pagination index (#1520)
  @@index([rematchOf])
  @@index([status])
  @@index([createdBy])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdBy, createdAt(sort: Desc), id(sort: Desc)])
  @@map("arenas")
}

model ArenaStats {
  id           String   @id @default(uuid())
  arenaId      String   @unique @map("arena_id")
  players      Int      @default(0)
  rounds       Int      @default(0)
  eliminations Int      @default(0)
  yieldAccrued Float    @default(0) @map("yield_accrued")
  version      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  arena Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@map("arena_stats")
}

model Pool {
  id          String   @id @default(uuid())
  arenaId     String   @map("arena_id")
  stakeAmount Float    @map("stake_amount") // Using Float for exact representations of crypto amounts
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  arena Arena @relation(fields: [arenaId], references: [id])

  @@index([arenaId]) // Index to quickly find pools for an arena
  @@index([arenaId, createdAt(sort: Desc), id(sort: Desc)]) // Keyset pagination index (#1520)
  @@map("pools")
}

model Round {
  id                 String   @id @default(uuid())
  arenaId            String   @map("arena_id")
  roundNumber        Int      @map("round_number")
  state              String   @default("OPEN") // OPEN, CLOSED, RESOLVED, SETTLED
  metadata           Json? // Legacy extensible metadata JSON document
  oracleYield        Float?   @map("oracle_yield")
  randomSeed         String?  @map("random_seed")
  playerChoices      Json?    @map("player_choices")
  allActivePlayerIds String[] @default([]) @map("all_active_player_ids")
  resolution         Json?    @map("resolution")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  arena           Arena            @relation(fields: [arenaId], references: [id])
  eliminationLogs EliminationLog[]

  @@unique([arenaId, roundNumber]) // Each round is unique per arena
  @@index([arenaId])
  @@index([arenaId, roundNumber(sort: Asc), id(sort: Asc)]) // Keyset pagination index (#1520)
  @@index([state])
  @@map("rounds")
}

// High-volume append-heavy ledger of Postgres-side transaction records,
// RANGE-partitioned by month on `createdAt` (#1622). Partitioned tables in
// PostgreSQL require the partition key in the primary key and in every unique
// constraint, so the PK is (id, createdAt) and the tx-hash uniqueness is
// (txHash, createdAt). Aged partitions are moved to the cold `archive` schema
// by the retention worker (docs/PARTITION_RETENTION_RUNBOOK.md).
model Transaction {
  id        String   @default(uuid())
  txHash    String   @map("tx_hash") // The on-chain transaction hash (unique per createdAt month)
  userId    String   @map("user_id")
  amount    Float // Amount involved
  type      String // Type of transaction e.g., "DEPOSIT", "WITHDRAW"
  status    String // Status of transaction e.g., "PENDING", "SUCCESS", "FAILED"
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@id([id, createdAt])
  @@unique([txHash, createdAt])
  @@index([userId])
  @@index([status]) // Useful for querying unconfirmed transactions
  @@map("transactions")
}

// Resumable cursor state for background reconciliation/backfill jobs.
// One row per job (keyed by `id`, e.g. "arena_discovery"), so a job resumes
// from where it left off across restarts instead of rescanning from scratch
// or losing progress (see docs/arena-discovery-backfill.md, #1391).
model BackfillCursor {
  id            String   @id // job name, e.g. "arena_discovery"
  lastProcessed Int      @default(0) @map("last_processed")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("backfill_cursors")
}

// One row per player elimination, RANGE-partitioned by month on
// `eliminatedAt` (#1622). The primary key includes the partition key as
// required by PostgreSQL partitioned tables. Old partitions are archived
// (never deleted) by the retention worker —
// docs/PARTITION_RETENTION_RUNBOOK.md documents restore procedures.
model EliminationLog {
  id           String   @default(uuid())
  roundId      String   @map("round_id")
  userId       String   @map("user_id")
  reason       String? // Reason for elimination if applicable
  eliminatedAt DateTime @default(now()) @map("eliminated_at")

  round Round @relation(fields: [roundId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@id([id, eliminatedAt])
  @@index([roundId])
  @@index([roundId, eliminatedAt(sort: Desc), id(sort: Desc)]) // Keyset pagination index (#1520)
  @@index([userId])
  @@map("elimination_logs")
}

model NotificationPreference {
  id                       String   @id @default(uuid())
  userId                   String   @unique @map("user_id")
  emailEnabled             Boolean  @default(false) @map("email_enabled")
  pushEnabled              Boolean  @default(false) @map("push_enabled")
  inAppEnabled             Boolean  @default(true) @map("in_app_enabled")
  roundNotifications       Boolean  @default(true) @map("round_notifications")
  payoutNotifications      Boolean  @default(true) @map("payout_notifications")
  eliminationNotifications Boolean  @default(true) @map("elimination_notifications")
  digestNotifications      Boolean  @default(true) @map("digest_notifications")
  email                    String?
  pushToken                String?  @map("push_token")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notification_preferences")
}

model NotificationDelivery {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String // "round" | "payout" | "elimination"
  channel   String // "email" | "push" | "in_app"
  status    String // "pending" | "sent" | "delivered" | "failed"
  dedupeKey String    @map("dedupe_key")
  sentAt    DateTime? @map("sent_at")
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, dedupeKey, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

// Web Push subscriptions, one row per (user, device endpoint) (#1571).
// p256dh/auth are AES-256-GCM encrypted at rest (see pushService);
// the service never returns them to clients.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("push_subscriptions")
}

// Per-(event, channel) opt-ins layered over the legacy boolean switches in
// NotificationPreference (#1735). A missing row means "inherit the legacy
// preference", so existing accounts keep their current behaviour.
model NotificationChannelPreference {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  eventType String   @map("event_type")
  channel   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, eventType, channel])
  @@index([userId])
  @@map("notification_channel_preferences")
}

// A linked Telegram chat or Discord user, keyed by channel so a wallet has at
// most one destination per platform. `externalId` is chat id (Telegram) or
// user id (Discord); neither is a secret. Platform tokens stay in env vars.
model NotificationChannelLink {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  channel     String
  externalId  String   @map("external_id")
  displayName String?  @map("display_name")
  metadata    Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, channel])
  @@unique([channel, externalId])
  @@index([userId])
  @@map("notification_channel_links")
}

// Short-lived one-time codes used by the Telegram `/start` and Discord
// `/link` bot commands. Only an HMAC digest is stored (#1735).
model NotificationLinkCode {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  channel   String
  codeHash  String   @unique @map("code_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notification_link_codes")
}

// Community destination configured by an arena host. The webhook URL carries
// bearer-like authority, so it is AES-256-GCM encrypted at rest.
model ArenaNotificationWebhook {
  id        String   @id @default(uuid())
  arenaId   String   @map("arena_id")
  url       String
  name      String?
  createdBy String   @map("created_by")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [createdBy], references: [id])
  arena     Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@index([arenaId])
  @@map("arena_notification_webhooks")
}

model HostWhitelistApplication {
  id          String    @id @default(uuid())
  wallet      String
  contact     String
  intent      String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | CONFIRMED
  reviewer    String?
  reviewNote  String?   @map("review_note")
  unsignedXdr String?   @map("unsigned_xdr")
  txHash      String?   @map("tx_hash")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  reviewedAt  DateTime? @map("reviewed_at")
  confirmedAt DateTime? @map("confirmed_at")

  @@index([wallet, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("host_whitelist_applications")
}

// Checkpointed on-chain arena projection state (#1382).
//
// One row per (network, arenaId): the canonical resume point for the
// projection replay engine. `lastLedgerSequence` is the highest ledger
// whose events have been folded into `projectionState`. Checkpoints are
// scoped per network so testnet and mainnet replays never share state
// (see docs/projection-checkpoint-replay.md).
model ArenaProjectionCheckpoint {
  id                 String    @id @default(uuid())
  arenaId            String    @map("arena_id")
  network            String // networkPassphrase-derived key; keeps testnet/mainnet checkpoints isolated
  lastLedgerSequence Int       @map("last_ledger_sequence")
  // Full folded ArenaProjectionState (see arenaProjectionFold.ts), stored as
  // JSON so the replay engine can resume without re-deriving state from
  // genesis. This is the "projection snapshot" referenced in the design note.
  projectionState    Json      @map("projection_state")
  status             String    @default("idle") // idle | replaying | caught_up | failed
  lastError          String?   @map("last_error")
  // Advisory lease to guard against two replay processes running
  // concurrently for the same (arenaId, network) after an ungraceful
  // restart. Null/expired lease means no active replayer.
  leaseOwner         String?   @map("lease_owner")
  leaseExpiresAt     DateTime? @map("lease_expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([arenaId, network])
  @@index([status])
  @@map("arena_projection_checkpoints")
}

// Protocol treasury fee reconciliation (#1511).
//
// One row per canonical fee expectation, derived from an authoritative
// on-chain event (currently: the platform fee implied by an arena's
// `claimed` event) and matched against actual on-chain token movement.
// Read-only reporting — this table never drives a transfer. See
// backend/docs/TREASURY_RECONCILIATION_DESIGN.md.
model TreasuryFeeRecord {
  id          String  @id @default(uuid())
  // networkPassphrase-derived key; keeps testnet/mainnet records isolated,
  // same convention as ArenaProjectionCheckpoint.network.
  network     String
  // "platform_fee" today; the schema leaves room for other treasury record
  // types (e.g. creator-stake collect/refund) as a documented follow-up.
  recordType  String  @default("platform_fee") @map("record_type")
  arenaId     String  @map("arena_id")
  asset       String
  assetIssuer String? @map("asset_issuer")

  // Canonical source event identity — the idempotency key (network, tx hash,
  // event/operation index) required by #1511's ingestion acceptance criterion.
  sourceTxHash         String   @map("source_tx_hash")
  sourceEventId        String   @map("source_event_id")
  sourceLedgerSequence Int      @map("source_ledger_sequence")
  sourceLedgerClosedAt DateTime @map("source_ledger_closed_at")

  // Expected side — derived from authoritative on-chain data (the claimed
  // event's yield_amount) and a versioned protocol config snapshot, using
  // exact integer (atomic-unit) math.
  expectedAmountAtomic BigInt  @map("expected_amount_atomic")
  configVersion        Int     @map("config_version")
  feeBpsApplied        Int     @map("fee_bps_applied")
  destination          String? @map("destination")

  // Actual side — filled in only once/if a matching transfer is found.
  actualAmountAtomic BigInt? @map("actual_amount_atomic")
  actualTxHash       String? @map("actual_tx_hash")
  actualDestination  String? @map("actual_destination")

  // pending | balanced | discrepant
  status          String    @default("pending")
  // missing_transfer | unexpected_transfer | amount_mismatch | destination_mismatch | unfinalized_ledger
  discrepancyType String?   @map("discrepancy_type")
  reconciledAt    DateTime? @map("reconciled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([network, sourceTxHash, sourceEventId])
  @@index([arenaId])
  @@index([status])
  @@index([sourceLedgerSequence])
  @@map("treasury_fee_records")
}

// Idempotent ingestion checkpoint for treasury reconciliation (#1511).
// Mirrors ArenaProjectionCheckpoint's per-(arenaId, network) lease pattern,
// scoped to this ingestion job specifically (a distinct job from the #1382
// arena state projection).
model TreasuryReconciliationCheckpoint {
  id                 String    @id @default(uuid())
  arenaId            String    @map("arena_id")
  network            String
  lastLedgerSequence Int       @map("last_ledger_sequence")
  // The `platform_fee_bps` in effect as of `lastLedgerSequence`, carried
  // forward across ingestion runs so a resumed run knows which fee rate
  // applied to a `claimed` event without re-scanning full history. Defaults
  // to the contract's own global default (see `load_platform_fee_bps`).
  lastKnownFeeBps    Int       @default(1000) @map("last_known_fee_bps")
  // idle | ingesting | caught_up | failed
  status             String    @default("idle")
  lastError          String?   @map("last_error")
  leaseOwner         String?   @map("lease_owner")
  leaseExpiresAt     DateTime? @map("lease_expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([arenaId, network])
  @@index([status])
  @@map("treasury_reconciliation_checkpoints")
}

// Request-level idempotency for arena lifecycle commands (#1386).
// One row per (idempotencyKey), checked BEFORE any side effect
// (on-chain submission, state transition) runs, so a duplicate/retried
// request returns the prior durable result instead of re-executing.
// Deliberately separate from Round.state: that field is coarse and
// shared across every caller, not a substitute for per-request dedup —
// see docs/ARENA_LIFECYCLE_IDEMPOTENCY.md.
model IdempotentCommand {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique @map("idempotency_key")
  action         String // "resolve_round" | "close_round"
  roundId        String   @map("round_id")
  status         String // "in_progress" | "completed" | "failed"
  result         Json? // The durable response body to replay on retry, once completed
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([roundId])
  @@map("idempotent_commands")
}

model OutboxEvent {
  id             String    @id @default(uuid())
  eventType      String    @map("event_type")
  aggregateId    String    @map("aggregate_id")
  dedupeKey      String    @unique @map("dedupe_key")
  payload        Json
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at")
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  publishedAt    DateTime? @map("published_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, availableAt, createdAt])
  @@index([leaseExpiresAt])
  @@map("outbox_events")
}

model CreatorTemplate {
  id            String   @id @default(uuid())
  ownerAddress  String   @map("owner_address")
  name          String
  schemaVersion Int      @default(1) @map("schema_version")
  status        String   @default("active")
  payload       Json
  revision      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([ownerAddress, name])
  @@index([ownerAddress, status, createdAt(sort: Desc)])
  @@map("creator_templates")
}

// Status page incident history (#1738).
//
// One row per incident: a component transitioning away from "operational"
// creates an incident; it is resolved when the component returns to
// "operational". The 30-day history window is enforced by a query-time
// filter, not a retention job — rows older than 30 days are pruned by
// the retention worker's cold-archive pass if the table is added to
// MANAGED_PARTITIONED_TABLES, but for now the small volume (a handful
// of incidents per month) means a simple createdAt index suffices.
model StatusIncident {
  id         String    @id @default(uuid())
  component  String // "api" | "stream" | "keeper" | "rpc" | "oracle" | "database" | "redis"
  status     String // "degraded" | "partial_outage" | "major_outage" | "maintenance"
  message    String
  startedAt  DateTime  @default(now()) @map("started_at")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([component, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@map("status_incidents")
}

// Progressive jackpot funded by platform fees (#1719)
model Jackpot {
  id             String   @id @default(uuid())
  stakeToken     String   @map("stake_token") // The token this jackpot is for
  balanceAtomic  BigInt   @default(0) @map("balance_atomic") // Balance in smallest unit
  shareBps       Int      @default(500) @map("share_bps") // Basis points of fees routed here
  awardRule      String   @default("PERFECT_STREAK") @map("award_rule") // Rule defining when to award
  awardThreshold Int?     @map("award_threshold") // Threshold value for award rule (e.g., N rounds survived)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  jackpotAwards JackpotAward[]

  @@unique([stakeToken])
  @@index([createdAt(sort: Desc)])
  @@map("jackpots")
}

// Award records for jackpot payouts (#1719)
model JackpotAward {
  id           String   @id @default(uuid())
  jackpotId    String   @map("jackpot_id")
  arenaId      String   @map("arena_id")
  winnerId     String   @map("winner_id")
  amountAtomic BigInt   @map("amount_atomic")
  awardReason  String   @map("award_reason") // Reason award was triggered
  txHash       String?  @map("tx_hash") // On-chain tx hash if paid out
  status       String   @default("pending") // pending | paid | failed
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  jackpot Jackpot @relation(fields: [jackpotId], references: [id], onDelete: Cascade)

  @@index([jackpotId])
  @@index([arenaId])
  @@index([winnerId])
  @@index([status])
  @@map("jackpot_awards")
}

// In-lobby chat and reactions (#1724)
model ArenaMessage {
  id          String   @id @default(uuid())
  arenaId     String   @map("arena_id")
  userId      String   @map("user_id")
  messageType String   @default("chat") // chat | reaction
  content     String // Chat text or emoji
  status      String   @default("active") // active | muted | deleted
  reportCount Int      @default(0) @map("report_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([arenaId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([status])
  @@map("arena_messages")
}

// User reports on arena messages (#1724)
model MessageReport {
  id         String   @id @default(uuid())
  messageId  String   @map("message_id")
  reporterId String   @map("reporter_id")
  reason     String // Reason for report (spam, abuse, etc.)
  status     String   @default("pending") // pending | reviewed | dismissed
  createdAt  DateTime @default(now()) @map("created_at")

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([reporterId])
  @@index([status, createdAt(sort: Desc)])
  @@map("message_reports")
}

// Follow relationships (#1723)
model Follow {
  id           String   @id @default(uuid())
  followerId   String   @map("follower_id")
  followingId  String   @map("following_id")
  isFollowable Boolean  @default(true) @map("is_followable")
  createdAt    DateTime @default(now()) @map("created_at")

  follower  User @relation("FollowedBy", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([followerId, createdAt(sort: Desc)])
  @@map("follows")
}

// Clan memberships and details (#1725)
model Clan {
  id           String   @id @default(uuid())
  name         String   @unique
  tag          String   @unique @db.VarChar(5)
  ownerAddress String   @map("owner_address")
  memberCount  Int      @default(1) @map("member_count")
  totalWins    Int      @default(0) @map("total_wins")
  totalStaked  Float    @default(0) @map("total_staked")
  avgWinRate   Float    @default(0) @map("avg_win_rate")
  joinPolicy   String   @default("open") // open | invite_only
  description  String?
  imageUrl     String?  @map("image_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  members ClanMember[]

  @@index([createdAt(sort: Desc)])
  @@index([totalWins(sort: Desc)])
  @@map("clans")
}

// Clan membership records (#1725)
model ClanMember {
  id        String   @id @default(uuid())
  clanId    String   @map("clan_id")
  userId    String   @map("user_id")
  role      String   @default("member") // owner | officer | member
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId]) // One clan per user at a time
  @@index([clanId])
  @@index([role])
  @@map("clan_members")
}

// Scheduled recurring arena series from creator templates (#1746)
model ArenaSeries {
  id               String    @id @default(uuid())
  creatorAddress   String    @map("creator_address")
  templateId       String    @map("template_id")
  name             String
  cadence          String // cron-like syntax e.g. "0 20 * * *" or "@daily"
  timezone         String    @default("UTC")
  status           String    @default("active") // "active" | "paused" | "completed" | "cancelled"
  endCondition     Json?     @map("end_condition") // { maxInstances?: number, endDate?: string }
  instancesCreated Int       @default(0) @map("instances_created")
  lastScheduledAt  DateTime? @map("last_scheduled_at")
  nextScheduledAt  DateTime? @map("next_scheduled_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  instances ArenaSeriesInstance[]

  @@index([creatorAddress, status])
  @@index([status, nextScheduledAt])
  @@map("arena_series")
}

model ArenaSeriesInstance {
  id                 String   @id @default(uuid())
  seriesId           String   @map("series_id")
  arenaId            String?  @map("arena_id")
  scheduledFor       DateTime @map("scheduled_for")
  status             String   @default("pending") // "pending" | "signed" | "created" | "skipped" | "failed"
  signRequestPayload Json?    @map("sign_request_payload")
  txHash             String?  @map("tx_hash")
  errorMessage       String?  @map("error_message")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  series ArenaSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId, status])
  @@index([scheduledFor, status])
  @@map("arena_series_instances")
}

// Webhook subscriptions for integrators (#XXXX)
model WebhookSubscription {
  id            String    @id @default(uuid())
  url           String // Must pass SSRF validation
  secret        String // HMAC-256 signing key
  eventFilters  String[]  @default(["*"]) @map("event_filters") // Empty or ["*"] means all; specific types otherwise
  status        String    @default("active") // "active" | "disabled"
  failureCount  Int       @default(0) @map("failure_count") // Consecutive delivery failures
  lastFailedAt  DateTime? @map("last_failed_at")
  lastSuccessAt DateTime? @map("last_success_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  deliveryLogs WebhookDeliveryLog[]

  @@index([status, createdAt(sort: Desc)])
  @@index([status])
  @@map("webhook_subscriptions")
}

// Delivery log for each webhook dispatch attempt
model WebhookDeliveryLog {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  outboxEventId  String   @map("outbox_event_id")
  idempotencyKey String   @map("idempotency_key") // Prevents replay duplication
  httpStatus     Int?     @map("http_status")
  responseTime   Int?     @map("response_time") // milliseconds
  error          String? // Error message if delivery failed
  status         String   @default("pending") // "pending" | "delivered" | "failed"
  attempt        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, idempotencyKey])
  @@index([subscriptionId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("webhook_delivery_logs")
}

// Referral program: codes, reward ledger, payout tracking
model ReferralCode {
  id              String   @id @default(uuid())
  referrerId      String   @map("referrer_id")
  code            String   @unique
  attributionWindowExpiresAt DateTime @map("attribution_window_expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  referrer User @relation("ReferralCodesIssued", fields: [referrerId], references: [id], onDelete: Cascade)
  rewards ReferralReward[]

  @@index([referrerId])
  @@index([code])
  @@map("referral_codes")
}

// Referral reward ledger: tracks referee signup, qualification, and payout
model ReferralReward {
  id              String   @id @default(uuid())
  referralCodeId  String   @map("referral_code_id")
  refereeId       String   @map("referee_id")
  // pending = referee signed up, awaiting qualification
  // qualified = referee completed N arenas with min stake
  // paid = reward paid out
  // revoked = referee ineligible (self-referral, already existed, etc.)
  state           String   @default("pending") // pending | qualified | paid | revoked
  arenaCount      Int      @default(0) @map("arena_count")
  totalStake      Float    @default(0) @map("total_stake")
  rewardAmount    Float?   @map("reward_amount")
  revokeReason    String?  @map("revoke_reason")
  createdAt       DateTime @default(now()) @map("created_at")
  qualifiedAt     DateTime? @map("qualified_at")
  paidAt          DateTime? @map("paid_at")

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  referee User @relation("ReferralRewardsReceived", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([referralCodeId, refereeId])
  @@index([refereeId])
  @@index([state, createdAt(sort: Desc)])
  @@map("referral_rewards")
}
