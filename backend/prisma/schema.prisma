// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TODO(#1444): Add production-plan-validated indexes for arena stats queries.
// TODO(#1444): Store the supporting EXPLAIN fixtures.

model User {
  id             String           @id @default(uuid())
  walletAddress  String           @unique @map("wallet_address")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  transactions   Transaction[]
  eliminationLogs EliminationLog[]

  @@map("users")
}

model Arena {
  id          String   @id @default(uuid())
  metadata    Json?    // Stores generic arena settings (e.g. entry fee, limits)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pools       Pool[]
  rounds      Round[]

  @@map("arenas")
}

model Pool {
  id          String   @id @default(uuid())
  arenaId     String   @map("arena_id")
  stakeAmount Float  @map("stake_amount") // Using Float for exact representations of crypto amounts
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  arena       Arena    @relation(fields: [arenaId], references: [id])

  @@index([arenaId]) // Index to quickly find pools for an arena
  @@map("pools")
}

model Round {
  id          String   @id @default(uuid())
  arenaId     String   @map("arena_id")
  roundNumber Int      @map("round_number")
  state       String   @default("OPEN") // OPEN, CLOSED, RESOLVED, SETTLED
  metadata    Json?    // Stores player choices, oracle yield, random seed
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  arena       Arena    @relation(fields: [arenaId], references: [id])
  eliminationLogs EliminationLog[]

  @@unique([arenaId, roundNumber]) // Each round is unique per arena
  @@index([arenaId])
  @@index([state])
  @@map("rounds")
}

model Transaction {
  id          String   @id @default(uuid())
  txHash      String   @unique @map("tx_hash") // The on-chain transaction hash
  userId      String   @map("user_id")
  amount      Float  // Amount involved
  type        String   // Type of transaction e.g., "DEPOSIT", "WITHDRAW"
  status      String   // Status of transaction e.g., "PENDING", "SUCCESS", "FAILED"
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status]) // Useful for querying unconfirmed transactions
  @@map("transactions")
}

// Resumable cursor state for background reconciliation/backfill jobs.
// One row per job (keyed by `id`, e.g. "arena_discovery"), so a job resumes
// from where it left off across restarts instead of rescanning from scratch
// or losing progress (see docs/arena-discovery-backfill.md, #1391).
model BackfillCursor {
  id            String   @id // job name, e.g. "arena_discovery"
  lastProcessed Int      @default(0) @map("last_processed")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("backfill_cursors")
}

model EliminationLog {
  id          String   @id @default(uuid())
  roundId     String   @map("round_id")
  userId      String   @map("user_id")
  reason      String?  // Reason for elimination if applicable
  eliminatedAt DateTime @default(now()) @map("eliminated_at")

  round       Round    @relation(fields: [roundId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([roundId])
  @@index([userId])
  @@map("elimination_logs")
}

// Checkpointed on-chain arena projection state (#1382).
//
// One row per (network, arenaId): the canonical resume point for the
// projection replay engine. `lastLedgerSequence` is the highest ledger
// whose events have been folded into `projectionState`. Checkpoints are
// scoped per network so testnet and mainnet replays never share state
// (see docs/projection-checkpoint-replay.md).
model ArenaProjectionCheckpoint {
  id                 String    @id @default(uuid())
  arenaId            String    @map("arena_id")
  network            String    // networkPassphrase-derived key; keeps testnet/mainnet checkpoints isolated
  lastLedgerSequence Int       @map("last_ledger_sequence")
  // Full folded ArenaProjectionState (see arenaProjectionFold.ts), stored as
  // JSON so the replay engine can resume without re-deriving state from
  // genesis. This is the "projection snapshot" referenced in the design note.
  projectionState    Json      @map("projection_state")
  status             String    @default("idle") // idle | replaying | caught_up | failed
  lastError          String?   @map("last_error")
  // Advisory lease to guard against two replay processes running
  // concurrently for the same (arenaId, network) after an ungraceful
  // restart. Null/expired lease means no active replayer.
  leaseOwner         String?   @map("lease_owner")
  leaseExpiresAt     DateTime? @map("lease_expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([arenaId, network])
  @@index([status])
  @@map("arena_projection_checkpoints")
}

// Request-level idempotency for arena lifecycle commands (#1386).
// One row per (idempotencyKey), checked BEFORE any side effect
// (on-chain submission, state transition) runs, so a duplicate/retried
// request returns the prior durable result instead of re-executing.
// Deliberately separate from Round.state: that field is coarse and
// shared across every caller, not a substitute for per-request dedup —
// see docs/ARENA_LIFECYCLE_IDEMPOTENCY.md.
model IdempotentCommand {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique @map("idempotency_key")
  action         String   // "resolve_round" | "close_round"
  roundId        String   @map("round_id")
  status         String   // "in_progress" | "completed" | "failed"
  result         Json?    // The durable response body to replay on retry, once completed
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([roundId])
  @@map("idempotent_commands")
}
